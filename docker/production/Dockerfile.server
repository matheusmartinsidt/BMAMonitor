FROM eclipse-temurin:17-jre-jammy

RUN groupadd --system --gid 10001 bmamonitor \
    && useradd --system --uid 10001 --gid bmamonitor --home-dir /opt/bmamonitor bmamonitor \
    && mkdir -p /opt/bmamonitor /var/log/thingsboard \
    && chown -R bmamonitor:bmamonitor /opt/bmamonitor /var/log/thingsboard

COPY application/target/*-boot.jar /opt/bmamonitor/server.jar
COPY docker/production/start-server.sh /opt/bmamonitor/start-server.sh
RUN chmod 0555 /opt/bmamonitor/start-server.sh

USER bmamonitor
WORKDIR /opt/bmamonitor
EXPOSE 8080
ENTRYPOINT ["/opt/bmamonitor/start-server.sh"]
