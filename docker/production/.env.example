# Copy this template to a path outside the Git checkout, for example /etc/bmamonitor/production.env.
BMAMONITOR_DOMAIN=monitor.example.com
ACME_EMAIL=admin@example.com
BMAMONITOR_IMAGE=bmamonitor/server:4.3.1.8
POSTGRES_DB=bmamonitor
POSTGRES_USER=bmamonitor
POSTGRES_PASSWORD=CHANGE_ME
VALKEY_PASSWORD=CHANGE_ME
JAVA_TOOL_OPTIONS=-Xms512m -Xmx2g
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
